#!/bin/sh
# Local gate for AGENTS.md's recording rules. CI (.github/workflows/ci.yml) runs only after a push, so this is the
# only thing standing between a session and a 6,000-line handoff.
#
# Install once, per clone:
#
#     git config core.hooksPath .githooks
#
# It stays out of the way when it cannot help: if the tool is not built the
# hook passes rather than blocking a commit for a reason that has nothing to do
# with the commit. A gate that fires when you cannot act on it is a gate people
# disable, and disabling it would take the budget check with it.

TOOL="src/DK2.Tools/bin/Release/net10.0/DK2.Tools.dll"

# --- Blocking: no co-author trailer of any kind, no trace of the work account ---
#
# Patterns live in leak-guard.sh, shared with pre-push. Runs before the tool
# check so an unbuilt tree cannot let one through.
. "$(dirname "$0")/leak-guard.sh"

if grep -qiE "$LEAK_COAUTHOR_RE" "$1"; then
    echo "commit-msg: co-author trailer found. No Co-Authored-By of any kind; AI help is" >&2
    echo "            credited as 'Assisted-by: Claude <noreply@anthropic.com>' (AGENTS.md)." >&2
    exit 1
fi

if grep -qi "$LEAK_WORK_RE" "$1"; then
    echo "commit-msg: the message mentions the work account. Remove it." >&2
    exit 1
fi

for ident in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    if git var "$ident" | grep -qi "$LEAK_WORK_RE"; then
        echo "commit-msg: $ident is the work account: $(git var "$ident" | sed 's/>.*/>/')" >&2
        echo "            git config user.email franjo.misetic@outlook.com" >&2
        exit 1
    fi
done

if git diff --cached -U0 --no-color --no-ext-diff | grep '^+' | grep -v '^+++' | grep -qiE "$LEAK_WORK_DOMAIN_RE"; then
    echo "commit-msg: a staged line adds the work domain:" >&2
    git diff --cached -U0 --no-color --no-ext-diff | grep -n '^+' | grep -iE "$LEAK_WORK_DOMAIN_RE" | head -5 >&2
    exit 1
fi

if [ ! -f "$TOOL" ]; then
    echo "commit-msg: DK2.Tools is not built, skipping the checks." >&2
    echo "            dotnet build DK2.slnx -c Release" >&2
    exit 0
fi

# --- Blocking: recording budgets on the commit body and the changed files ---
#
# Per-commit is the right granularity for both: the message is written now, and
# the changed material is what this commit is adding to the repo.
if ! dotnet "$TOOL" docs --message "$1"; then
    echo >&2
    echo "commit-msg: over budget. Fix it, or commit with --no-verify if you" >&2
    echo "            have a reason and can say what it is." >&2
    exit 1
fi

# --- Blocking: the function knowledge base (AGENTS.md, HARD rule) -------
#
# A function named in this commit has a record; a record whose verdict this
# commit changes carries a History line dated today.
if ! dotnet "$TOOL" kb check --staged; then
    echo >&2
    echo "commit-msg: the function knowledge base is behind this commit." >&2
    echo "            write or update docs/research/functions/<ADDRESS>.md, then re-run." >&2
    exit 1
fi

# --- Advisory: the plan's status paragraph -------------------------------
#
# Deliberately NOT blocking. The status line is a reference for whoever reads
# the plan, not a correctness invariant, and almost every commit that adds a
# test or an ADR changes one of its numbers. Blocking each one would teach
# everybody to pass --no-verify, which would silently switch off the budget
# check above. So: say it, and let the author decide when to regenerate.
if ! dotnet "$TOOL" status --check >/dev/null 2>&1; then
    echo >&2
    echo "note: the plan's status line is now stale. When convenient:" >&2
    echo "        dotnet build DK2.slnx -c Release" >&2
    echo "        dotnet run --project src/DK2.Tools -c Release --no-build -- status" >&2
    echo "      and paste the paragraph into DK2_REIMPLEMENTATION_PLAN.md." >&2
    echo "      (Committing anyway is fine; this is a note, not a failure.)" >&2
fi

exit 0
