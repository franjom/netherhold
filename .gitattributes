# Shell scripts must keep LF: a CRLF shebang is a "bad interpreter" error on
# any non-Windows checkout, and git hooks are the one place that bites silently.
.githooks/* text eol=lf
*.sh text eol=lf

# Captured game output is evidence: keep its bytes (CRLF included) exactly as written.
docs/research/samples/*.log -text
docs/research/samples/*.gz binary
