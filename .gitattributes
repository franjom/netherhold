# Shell scripts must keep LF: a CRLF shebang is a "bad interpreter" error on
# any non-Windows checkout, and git hooks are the one place that bites silently.
.githooks/* text eol=lf
*.sh text eol=lf

# Shared skill provenance hashes must survive Windows checkouts unchanged.
.agents/skills/** text eol=lf
.claude/skills/** text eol=lf

# Captured game output is evidence: keep its bytes (CRLF included) exactly as written.
docs/research/samples/*.log -text
docs/research/samples/*.gz binary

# A replayed journal names its scenario by SHA-256: keep both files byte for byte.
tests/DK2.Behavior.Tests/Fixtures/**/*.yaml -text
tests/DK2.Behavior.Tests/Fixtures/**/*.journal binary
tests/DK2.Presentation.Tests/Fixtures/**/*.journal binary

# Godot writes LF on every platform; without this, core.autocrlf checkouts make every
# scene and resource the editor touches show as a whole-file diff (ADR-0810).
godot/** text=auto eol=lf

# C# source: stored LF in the repository, checked out in the platform's line endings
# (CRLF on Windows, matching .editorconfig), so line endings never show as a diff.
*.cs text
