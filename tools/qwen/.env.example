# Template only: configure these in your terminal/user environment.
# The adapter does not automatically load .env files.
# Include the API version prefix supplied by the server operator (usually /v1).
QWEN_API_BASE_URL=
QWEN_API_KEY=
# Discover the actual identifier with validate-api; do not assume Qwen3.8.
QWEN_MODEL_ID=
# Obtain these limits from the server operator; model discovery may omit them.
QWEN_CONTEXT_TOKENS=
QWEN_OUTPUT_TOKENS=
