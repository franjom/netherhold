# EditorConfig for the Dungeon Keeper 2 reimplementation.
#
# Deliberately narrow. Directory.Build.props sets both EnforceCodeStyleInBuild
# and TreatWarningsAsErrors, so any rule given a severity here becomes a build
# error in every project at once. Add one only in a commit that also fixes
# every file it flags.

root = true

[*.cs]

# Working copies are CRLF (the owner works on Windows, 2026-11-20); the
# repository stores LF. .gitattributes normalises *.cs with `text`, so git
# converts on commit and checkout and a line-ending change never shows as a
# diff. Editors and `dotnet format` write CRLF to match a Windows checkout.
end_of_line = crlf
insert_final_newline = true

# ---------------------------------------------------------------------------
# The GPLv3 file notice is NOT enforced here. That is a choice, not an
# oversight, and it survives the notice getting shorter.
#
# IDE0073 with file_header_template truncates its value at the first ";"
# without a diagnostic. The long-form GPL notice used briefly on
#    2026-09-04 has a semicolon in
#
#        but WITHOUT ANY WARRANTY; without even the implied warranty of
#
#    and IDE0073 enforced - and `dotnet format` wrote into seven files - a
#    notice whose warranty disclaimer had been cut in half, with a green build,
#    because the files matched the truncated template exactly.
#
#    The current three-line notice has no semicolon, so IDE0073 would work
#    today. It is still not used, because "works as long as nobody lengthens
#    the text" is the kind of accident this project has been bitten by before
#    (ADR-0036, ADR-0039, ADR-0040) and the failure mode is silent.
#
# The notice is enforced by tests/DK2.Core.Tests/LicenseHeaderTests.cs, which
# renders license.txt and asserts every source file starts with it. CI already
# runs `dotnet test DK2.slnx` on Linux and Windows, so it is gated with no new
# workflow step. See ADR-0041.
# ---------------------------------------------------------------------------

csharp_using_directive_placement = outside_namespace
dotnet_diagnostic.IDE0065.severity = warning

csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = false
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning

csharp_prefer_braces = true
dotnet_diagnostic.IDE0011.severity = warning

dotnet_naming_symbols.step6_private_fields.applicable_kinds = field
dotnet_naming_symbols.step6_private_fields.applicable_accessibilities = private
dotnet_naming_rule.step6_private_fields.symbols = step6_private_fields
dotnet_naming_rule.step6_private_fields.style = step6_instance_field
dotnet_naming_rule.step6_private_fields.severity = warning
dotnet_naming_symbols.step6_private_mutable_statics.applicable_kinds = field
dotnet_naming_symbols.step6_private_mutable_statics.applicable_accessibilities = private
dotnet_naming_symbols.step6_private_mutable_statics.required_modifiers = static
dotnet_naming_rule.step6_private_mutable_statics.symbols = step6_private_mutable_statics
dotnet_naming_rule.step6_private_mutable_statics.style = step6_mutable_static
dotnet_naming_rule.step6_private_mutable_statics.severity = warning
dotnet_naming_symbols.step6_private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.step6_private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.step6_private_static_readonly.required_modifiers = static,readonly
dotnet_naming_rule.step6_private_static_readonly.symbols = step6_private_static_readonly
dotnet_naming_rule.step6_private_static_readonly.style = step6_pascal_field
dotnet_naming_rule.step6_private_static_readonly.severity = warning
dotnet_naming_symbols.step6_private_constants.applicable_kinds = field
dotnet_naming_symbols.step6_private_constants.applicable_accessibilities = private
dotnet_naming_symbols.step6_private_constants.required_modifiers = const
dotnet_naming_rule.step6_private_constants.symbols = step6_private_constants
dotnet_naming_rule.step6_private_constants.style = step6_pascal_field
dotnet_naming_rule.step6_private_constants.severity = warning
dotnet_naming_symbols.step6_constants.applicable_kinds = field
dotnet_naming_symbols.step6_constants.applicable_accessibilities = *
dotnet_naming_symbols.step6_constants.required_modifiers = const
dotnet_naming_rule.step6_constants.symbols = step6_constants
dotnet_naming_rule.step6_constants.style = step6_pascal_field
dotnet_naming_rule.step6_constants.severity = warning
dotnet_naming_symbols.step6_static_readonly.applicable_kinds = field
dotnet_naming_symbols.step6_static_readonly.applicable_accessibilities = *
dotnet_naming_symbols.step6_static_readonly.required_modifiers = static,readonly
dotnet_naming_rule.step6_static_readonly.symbols = step6_static_readonly
dotnet_naming_rule.step6_static_readonly.style = step6_pascal_field
dotnet_naming_rule.step6_static_readonly.severity = warning
dotnet_naming_style.step6_instance_field.capitalization = camel_case
dotnet_naming_style.step6_instance_field.required_prefix = _
dotnet_naming_style.step6_mutable_static.capitalization = camel_case
dotnet_naming_style.step6_mutable_static.required_prefix = s_
dotnet_naming_style.step6_pascal_field.capitalization = pascal_case
dotnet_diagnostic.IDE1006.severity = warning

dotnet_style_prefer_collection_expression = when_types_exactly_match
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
dotnet_diagnostic.IDE0306.severity = warning

csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning

dotnet_sort_system_directives_first = true

dotnet_naming_style.step6_local_camel_case.capitalization = camel_case
dotnet_naming_symbols.step6_local_variables.applicable_kinds = local
dotnet_naming_symbols.step6_local_variables.applicable_accessibilities = *
dotnet_naming_rule.step6_local_variables.symbols = step6_local_variables
dotnet_naming_rule.step6_local_variables.style = step6_local_camel_case
dotnet_naming_rule.step6_local_variables.severity = warning

dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false
dotnet_diagnostic.IDE0003.severity = warning
