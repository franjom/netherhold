# EditorConfig for the Dungeon Keeper 2 reimplementation.
#
# Deliberately narrow. Directory.Build.props sets both EnforceCodeStyleInBuild
# and TreatWarningsAsErrors, so any rule given a severity here becomes a build
# error in every project at once. Add one only in a commit that also fixes
# every file it flags.

root = true

[*.cs]

# The repository is LF throughout. Say so explicitly, because `dotnet format`
# will otherwise rewrite a whole file to CRLF on Windows the first time it
# touches it, burying a one-line change in a few hundred lines of noise.
end_of_line = lf
insert_final_newline = true

# ---------------------------------------------------------------------------
# The GPLv3 file notice is NOT enforced here. That is a choice, not an
# oversight, and it survives the notice getting shorter.
#
# The obvious mechanism is IDE0073 with file_header_template, and with
# EnforceCodeStyleInBuild already set it is a build error for free. Two reasons
# it is not used:
#
# 1. It is blind to unity/DK2.Unity/Assets. No project in DK2.slnx compiles
#    those three files - only unity/DK2.Unity.Compile does, and that needs an
#    installed Unity editor (ADR-0036) - so a build-time analyser cannot see
#    precisely the files most easily forgotten.
#
# 2. It truncates a template at the first ";" and does not say so. That is not
#    hypothetical: the long-form GPL notice this project used briefly on
#    2026-09-04 has a semicolon in
#
#        but WITHOUT ANY WARRANTY; without even the implied warranty of
#
#    and IDE0073 enforced - and `dotnet format` wrote into seven files - a
#    notice whose warranty disclaimer had been cut in half, with a green build,
#    because the files matched the truncated template exactly.
#
#    The current three-line notice has no semicolon, so IDE0073 would work
#    today. It is still not used, because "works as long as nobody lengthens
#    the text" is the kind of accident this project has been bitten by before
#    (ADR-0036, ADR-0039, ADR-0040) and the failure mode is silent.
#
# The notice is enforced by tests/DK2.Core.Tests/LicenseHeaderTests.cs, which
# renders license.txt and asserts every source file starts with it. CI already
# runs `dotnet test DK2.slnx` on Linux and Windows, so it is gated with no new
# workflow step. See ADR-0041.
# ---------------------------------------------------------------------------
