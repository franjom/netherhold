<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Unity-bound assemblies target netstandard2.1 so that the "simulation must not
    depend on Unity, and must be loadable BY Unity" constraint is enforced by the
    compiler from day one rather than discovered at milestone M3.
    See docs/DECISIONS.md ADR-0002.
  -->
  <PropertyGroup Condition="'$(DK2UnityBound)' == 'true'">
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DK2UnityBound)' != 'true'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup Condition="'$(DK2UnityBound)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)src/Shared/Polyfills.cs" Link="Properties/Polyfills.cs" />
  </ItemGroup>

</Project>
