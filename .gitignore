# Build output
[Bb]in/
[Oo]bj/
build/
artifacts/
TestResults/
*.user
*.suo
.vs/
.idea/
.vscode/

# ---------------------------------------------------------------
# NEVER COMMIT: original Dungeon Keeper 2 material.
# Proprietary, EA-owned. Local development reference only.
# ---------------------------------------------------------------
original-reference/**
!original-reference/README.md
!original-reference/research/
!original-reference/research/**

# Converted assets derived from the original game are equally proprietary.
converted-assets/
*.kwd
*.kld
*.wad
*.kmf
*.sdt
*.tgq
*.bf4

# Unity
unity/**/Library/
unity/**/Temp/
unity/**/Logs/
unity/**/UserSettings/
unity/**/Build/

# Local config
local.settings.json
*.local.json

# Unity: the DK2 assemblies are build output, synced by unity/sync-assemblies.ps1
unity/DK2.Unity/Assets/Plugins/DK2/*.dll
unity/DK2.Unity/Assets/Plugins/DK2/*.pdb
unity/DK2.Unity/Assets/Plugins/DK2/*.meta
# Unity: Bullfrog's DungeonKeeperII TrueType font (Astigmatic One Eye, 1998) is not ours to
# ship; each machine supplies it (unity/README.md).
unity/DK2.Unity/Assets/Resources/Fonts/
unity/DK2.Unity/Assets/Resources/Fonts.meta
unity/DK2.Unity/Assets/Resources.meta
unity/**/obj/

# Unity regenerates these from the asmdefs on every open; they are not sources.
# Scoped to the Unity project so src/**/*.csproj and unity/DK2.Unity.Compile stay tracked.
unity/DK2.Unity/*.csproj
unity/DK2.Unity/*.sln
unity/DK2.Unity/.vsconfig

# ---------------------------------------------------------------
# NEVER COMMIT: decompiler output. Derived from EA's executable and
# therefore the same proprietary material as the binary itself.
# Facts and formulas learnt here belong in docs/research/ in our own
# words, with provenance. See ADR-0046 and reverse-engineering/README.md.
# ---------------------------------------------------------------
reverse-engineering/**
!reverse-engineering/README.md

# Cygwin/MSYS crash dumps, which a crashing grep leaves in the working tree
*.stackdump

# Python bytecode from tools/ghidra scripts run or imported directly
__pycache__/
*.pyc

# Experiment write-ups and run outputs live in D:\DK2Evidence (owner, 2026-10-24).
# Untracked 2026-10-26; the copy is D:\DK2Evidence\experiments (SHA-256 manifest beside it).
docs/experiments/
