# Build output
[Bb]in/
[Oo]bj/
build/
artifacts/
TestResults/
*.user
*.suo
.vs/
.idea/
.vscode/*
!.vscode/tasks.json

# Local Qwen harness and credentials (templates remain tracked).
tools/qwen/.runtime/
tools/qwen/.env
.worktrees/
.claude/worktrees/

# ---------------------------------------------------------------
# NEVER COMMIT: original Dungeon Keeper 2 material.
# Proprietary, EA-owned. Local development reference only.
# ---------------------------------------------------------------
original-reference/**
!original-reference/README.md
!original-reference/research/
!original-reference/research/**

# Converted assets derived from the original game are equally proprietary.
converted-assets/
*.kwd
*.kld
*.wad
*.kmf
*.sdt
*.tgq
*.bf4

# Local config
local.settings.json
*.local.json

# Godot (ADR-0810): the import cache, C# build output, and the Godot AI addon, which is agent
# tooling that godot/setup.ps1 installs at the version godot/godot-version.json pins.
godot/**/.godot/
godot/**/bin/
godot/**/obj/
godot/**/addons/godot_ai/
godot/**/addons/.godot_ai_update/
godot/**/mono_crash.*.json
# A local project-settings override for fixed-size captures (godot/README.md).
godot/**/override.cfg
# Bullfrog's DungeonKeeperII.ttf for the front end's replacement font: not ours to ship (godot/README.md).
godot/**/Fonts/*
!godot/DK2.Godot/Fonts/.gdignore

# ---------------------------------------------------------------
# NEVER COMMIT: decompiler output. Derived from EA's executable and
# therefore the same proprietary material as the binary itself.
# Facts and formulas learnt here belong in docs/research/ in our own
# words, with provenance. See ADR-0046 and reverse-engineering/README.md.
# ---------------------------------------------------------------
reverse-engineering/**
!reverse-engineering/README.md

# Cygwin/MSYS crash dumps, which a crashing grep leaves in the working tree
*.stackdump

# Python bytecode from tools/ghidra scripts run or imported directly
__pycache__/
*.pyc

# Experiment write-ups and run outputs live in F:\DK2Evidence (owner, 2026-10-24).
# Evidence locations and manifests: F:/DK2Evidence/catalog/INDEX.md.
docs/experiments/
