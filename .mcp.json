{
  "mcpServers": {
    "pyghidra-mcp": {
      "type": "stdio",
      "command": "python",
      "args": ["D:/DungeonKeeperRemake/tools/ghidra/mcp-serve.py", "--agent", "claude"]
    },
    "dk2kb": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--quiet", "D:/DungeonKeeperRemake/tools/kb/dk2kb.py"]
    },
    "blender": {
      "type": "stdio",
      "command": "uvx",
      "args": ["mcp-for-blender@2.1.9"],
      "env": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true"
      }
    }
  }
}
